<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400" prefWidth="600" stylesheets="@../Styles/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.fxmlController">

    <top>
        <Label fx:id="title" styleClass="chat-title" text="EasyChat" BorderPane.alignment="CENTER" />
    </top>

    <center>
    <VBox BorderPane.alignment="CENTER">
        <children>

            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        styleClass="scroll-pane">

                <content>
                    <VBox fx:id="chatBox"
                          spacing="10"
                          styleClass="chat-box" />
                </content>

            </ScrollPane>

        </children>
    </VBox>
</center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="bottom-bar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="button" onAction="#attachFiles" mnemonicParsing="false" styleClass="add-button">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@../Images/paper-clip-attach.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            		<TextArea fx:id="messageField" promptText="Message" wrapText="true" prefRowCount="1" prefHeight="35.0" prefWidth="300" minHeight="35.0" maxHeight="100.0" styleClass="message-field" />
            	<Button fx:id="sendButton" onAction="#sendMessage" visible="false" mnemonicParsing="false" managed="false" styleClass="send-button">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                            <image>
                                <Image url="@../Images/sendIcon.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </bottom>

</BorderPane>
